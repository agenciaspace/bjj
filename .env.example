# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git!

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_API_KEY=your_supabase_api_key_here

# Google Gemini AI (Optional - for AI Coach feature)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# DeepFace API (For facial recognition features)
VITE_DEEPFACE_API_URL=https://your-vercel-project.vercel.app/api
